# 复制为 .env 后填写。不要把填好密钥的 .env 提交到 GitHub。
# copy env.example .env
# 硅基流动示例；其他 OpenAI 兼容网关可替换下面两项。
RADAR_LLM=1
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID_TYPE=email
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_MOBILE=
FEISHU_MODE=mock
RADAR_HOST=0.0.0.0
PORT=8765
RADAR_PUSH_THRESHOLD=85
RADAR_PUSH_LIMIT=2
RADAR_PUSH_DRY_RUN=0
RADAR_OBSERVE_MINUTES=180
RADAR_OBSERVE_ON_START=0
MEMORYOS_ENABLED=0
MEMORYOS_ROOT=
VEHICLEMEM_ROOT=
