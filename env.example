# 复制为 .env 后填写。不要把填好密钥的 .env 提交到 GitHub。
# copy env.example .env
# 也可登录后在「设置 → 大模型」里填写，保存到本机 data/llm.json。
# 硅基流动示例；其他 OpenAI 兼容网关可替换下面两项。
RADAR_LLM=1
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID_TYPE=email
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_MOBILE=
FEISHU_MODE=mock
# 飞书入站对话：配好 App ID/Secret 后默认开启长连接。设为 0 可关闭。
FEISHU_INBOX=1
# 无法用 open_id / 邮箱匹配到账号时，把消息记到这个内部用户（alice 或 bob）。
FEISHU_INBOX_USER=
# 使用 HTTP 回调时填写；长连接可不填。
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 回复较慢时，先在飞书展示自然的处理中提示；0 表示关闭。
FEISHU_PROGRESS_DELAY=1.2
RADAR_HOST=0.0.0.0
PORT=8765
RADAR_PUSH_THRESHOLD=78
RADAR_PUSH_LIMIT=3
RADAR_PUSH_DRY_RUN=0
RADAR_FEED_LIMIT=30
RADAR_OBSERVE_MINUTES=60
RADAR_OBSERVE_ON_START=1
RADAR_REMIND_MINUTES=1
RADAR_REMIND_ON_START=1
# 知乎开放平台搜索；同时用于限定 mp.weixin.qq.com 的公众号文章搜索。
ZHIHU_ACCESS_SECRET=
ZHIHU_OPENAPI_BASE_URL=https://developer.zhihu.com
MEMORYOS_ENABLED=0
MEMORYOS_ROOT=
VEHICLEMEM_ROOT=
